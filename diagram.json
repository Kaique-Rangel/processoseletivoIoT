{
  "version": 1,
  "author": "Kaique",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": -60,
      "left": 200,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 100,
      "left": 200,
      "rotate": 0,
      "attrs": { "color": "blue" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "ldr1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ldr1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "ldr1:AO", "esp:35", "blue", [ "v0" ] ],
    [ "btn1:1.l", "esp:GND.2", "black", [ "v0" ] ],
    [ "btn1:2.l", "esp:13", "green", [ "v0" ] ]
  ],
  "dependencies": {}
}